# Spotify app (developer.spotify.com → your app → Settings). The redirect URI must be
# listed there exactly. Spotify rejects "localhost" — use 127.0.0.1 for local dev.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Optional PIN to unlock admin on a device (unset = open, fine for local testing).
KIOSK_PIN=

# Where clips come from (the Soundboard app's open read API).
SOUNDBOARD_URL=https://soundboard.dabrewer.dev

# Server only: dev env banner
# JARVIS_ENV=dev
# KIOSK_DB_PATH=/opt/music-kiosk/data/kiosk.db
